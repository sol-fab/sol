{
  "versions": {
    "redpanda": "26.1.11",
    "postgresql": "18.8.17",
    "loki": "18.12.1",
    "grafana": "13.2.1",
    "alloy": "1.12.1",
    "tempo": "2.3.0",
    "prometheus": "25.20.1",
    "ingress-nginx": "4.10.1"
  },
  "grafana": {
    "common": {
      "sidecar": {
        "dashboards": {
          "enabled": true
        },
        "datasources": {
          "enabled": true
        }
      }
    },
    "local": {},
    "durable": {}
  },
  "loki": {
    "common": {
      "gateway": {
        "enabled": false
      },
      "loki": {
        "auth_enabled": false
      }
    },
    "local": {
      "deploymentMode": "Monolithic",
      "singleBinary": {
        "replicas": 1,
        "persistence": {
          "enabled": false
        }
      },
      "write": {
        "replicas": 0
      },
      "read": {
        "replicas": 0
      },
      "backend": {
        "replicas": 0
      },
      "loki": {
        "commonConfig": {
          "replication_factor": 1
        },
        "storage": {
          "type": "filesystem"
        },
        "useTestSchema": true
      }
    },
    "durable": {
      "deploymentMode": "Monolithic",
      "singleBinary": {
        "replicas": 1
      },
      "write": {
        "replicas": 0
      },
      "read": {
        "replicas": 0
      },
      "backend": {
        "replicas": 0
      },
      "loki": {
        "commonConfig": {
          "replication_factor": 1
        },
        "storage": {
          "type": "s3"
        },
        "useTestSchema": false,
        "schemaConfig": {
          "configs": [
            {
              "from": "2024-01-01",
              "store": "tsdb",
              "object_store": "s3",
              "schema": "v13",
              "index": {
                "prefix": "index_",
                "period": "24h"
              }
            }
          ]
        }
      }
    }
  },
  "postgresql": {
    "common": {
      "auth": {
        "database": "dev"
      },
      "metrics": {
        "enabled": true
      }
    },
    "local": {
      "auth": {
        "postgresPassword": "dev"
      },
      "primary": {
        "persistence": {
          "enabled": false
        }
      }
    },
    "durable": {}
  },
  "prometheus": {
    "common": {
      "pushgateway": {
        "enabled": true
      },
      "alertmanager": {
        "enabled": true
      }
    },
    "local": {
      "server": {
        "persistentVolume": {
          "enabled": false
        }
      }
    },
    "durable": {}
  },
  "redpanda": {
    "common": {
      "clusterDomain": "cluster.local",
      "tls": {
        "enabled": false
      },
      "config": {
        "cluster": {
          "auto_create_topics_enabled": true
        }
      },
      "console": {
        "enabled": false,
        "ingress": {
          "className": ""
        },
        "service": {
          "targetPort": 8080
        }
      },
      "statefulset": {
        "podTemplate": {
          "annotations": {
            "prometheus.io/scrape": "true",
            "prometheus.io/port": "9644",
            "prometheus.io/path": "/public_metrics"
          }
        }
      }
    },
    "local": {
      "statefulset": {
        "replicas": 1
      },
      "resources": {
        "cpu": {
          "cores": "1.5"
        }
      }
    },
    "durable": {
      "tls": {
        "enabled": true
      },
      "auth": {
        "sasl": {
          "enabled": true,
          "mechanism": "SCRAM-SHA-256",
          "secretRef": "redpanda-users"
        }
      },
      "listeners": {
        "schemaRegistry": {
          "tls": {
            "cert": "default"
          }
        }
      },
      "storage": {
        "persistentVolume": {
          "size": "20Gi"
        }
      }
    }
  },
  "tempo": {
    "common": {},
    "local": {},
    "durable": {}
  }
}
