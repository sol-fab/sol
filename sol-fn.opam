# Hand-written because Dune cannot generate `pin-depends`.
# Pins target immutable commits; remove them when dependencies are published.
opam-version: "2.0"
synopsis: "Sol's scheduled-function application shape"
authors: "Logan Nielsen"
maintainer: "Logan Nielsen <lbendtlynielsen@gmail.com>"
license: "Apache-2.0"
homepage: "https://github.com/sol-fab/sol"
bug-reports: "https://github.com/sol-fab/sol/issues"
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.0"}
  "eio" "lambda-eio" "obs-eio" "obs-prometheus-eio"
  "sol-env" "sol-obs" "sol-runtime" "sol-svc"
  "http" "uri" "yojson" "base64"
]
pin-depends: [
  [ "lambda-eio.0.1.0" "git+https://github.com/loganbnielsen/lambda-eio.git#4a0cf964238fbef87e4b691c067b958f4cfe35bd" ]
]
build: [
  [ "dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} ]
]
