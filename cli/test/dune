  (bash
   "set -eu\nsol=$(pwd)/../bin/main.exe\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\nexpect() {\n  want=$1; shift\n  if \"$@\" >\"$tmp/out\" 2>\"$tmp/err\"; then got=0; else got=$?; fi\n  if [ \"$got\" != \"$want\" ]; then\n    echo \"expected exit $want, got $got: $*\" >&2; cat \"$tmp/err\" >&2; exit 1\n  fi\n}\nmkdir -p \"$tmp/outside\" \"$tmp/ws/app/payments/charge_svc\"\ncd \"$tmp/outside\"\nexpect 1 \"$sol\" check\ngrep -F 'sol: not inside a Sol workspace' \"$tmp/err\" >/dev/null\ncd \"$tmp/ws\"\ntouch sol.yml\nexpect 2 \"$sol\" check\ngrep -F 'Dockerfile is missing' \"$tmp/err\" >/dev/null\nif [ -n \"$(tail -n 1 \"$tmp/err\")\" ]; then :; else echo 'sol check printed a blank line after its findings' >&2; exit 1; fi\nexpect 1 \"$sol\" new svc bad\ngrep -Fx 'error: expected domain/name (e.g. payments/charge), got \"bad\"' \"$tmp/err\" >/dev/null\nexpect 1 \"$sol\" new workspace sol.yml\ngrep -Fx 'error: \"sol.yml\" already exists' \"$tmp/err\" >/dev/null\nexpect 124 \"$sol\" local rollback \"\"\ngrep -F 'must not be blank' \"$tmp/err\" >/dev/null")))

