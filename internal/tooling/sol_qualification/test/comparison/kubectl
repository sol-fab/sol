#!/usr/bin/python3
"""Temporary I4 API fixture transport. Never delegates to a real executable."""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["I4_WORLD"]) as source:
    world = json.load(source)
if args[:1] == ["--kubeconfig"]:
    args = args[2:]
def unsupported():
    with open(os.environ["I4_CALLS"], "a") as log:
        log.write(json.dumps({"unsupported": args}) + "\n")
    sys.stderr.write("unsupported offline query\n")
    sys.exit(126)

if len(args) not in (5, 7) or args[0] != "get" or args[3] != "-n":
    unsupported()
kind, name, namespace = args[1], args[2], args[4]
kind = {"deploy": "Deployment", "configmap": "ConfigMap", "secret": "Secret"}.get(kind)
if kind is None or (len(args) == 7 and args[5] != "-o"):
    unsupported()
mode = args[6] if len(args) == 7 else "default"
if mode not in ("name", "json", "default", "jsonpath={.data.POSTGRES_URL}"):
    unsupported()
with open(os.environ["I4_CALLS"], "a") as log:
    log.write(json.dumps({"resource": kind, "name": name, "namespace": namespace, "mode": mode}) + "\n")
entry = next((r for r in world["resources"] if (r["resource"], r["name"], r["namespace"]) == (kind, name, namespace)), None)
if entry is None:
    sys.stderr.write("Error from server (NotFound): fixture object not found\n")
    sys.exit(1)
code = entry.get("code", 0)
sys.stderr.write(entry.get("stderr", ""))
if "stdout" in entry:
    sys.stdout.write(entry["stdout"])
elif code == 0:
    obj = entry["object"]
    if mode == "name":
        sys.stdout.write(kind.lower() + "/" + obj.get("metadata", {}).get("name", "") + "\n")
    elif mode.startswith("jsonpath="):
        # The only projection the unchanged delivery gates request. Do not make a
        # failed CA read into absence or implement any qualification predicate.
        sys.stdout.write(obj.get("data", {}).get("POSTGRES_URL", ""))
    elif mode == "json" or mode == "default":
        sys.stdout.write(json.dumps(obj) + "\n")
sys.exit(code)
