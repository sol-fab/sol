#!/usr/bin/env bash
set -eu
printf 'gcloud %s\n' "$*" >>"$LIFECYCLE_LOG"
case "$1 $2" in
  "auth application-default") : ;;
  *)
    case " $* " in
      *" --project sol-qualification "*|*" --project=sol-qualification "*) : ;;
      *" storage buckets describe "*|*" dns managed-zones list "*|*" dns managed-zones describe "*) : ;;
      *) exit 91 ;;
    esac
    ;;
esac
case " $* " in
  *" storage buckets describe gs://sol-qualification-tfstate "*)
    printf 'sol-qualification-tfstate\n'
    exit 0
    ;;
  *" dns managed-zones list "*)
    printf '[{"name":"qual-example-test","dnsName":"qual.example.test."}]\n'
    exit 0
    ;;
  *" dns managed-zones describe qual-example-test "*)
    printf 'qual-example-test\n'
    exit 0
    ;;
esac
case " $* " in
  *" container clusters list "*)
    if [ "${SUBSTRATE_ABSENT_AT_PROVIDER:-}" != 1 ] &&
      [ ! -e "${LIFECYCLE_LOG}.destroyed" ]; then
      case " $* " in
        *" --project sol-qualification "*|*" --project=sol-qualification "*) printf 'sol-qual\n' ;;
      esac
    fi
    exit 0
    ;;
esac
case " $* " in
  *" container clusters list "*|*" container node-pools list "*|*" compute networks list "*|\
    *" compute networks subnets list "*|*" compute routers list "*|*" compute addresses list "*|\
    *" artifacts repositories list "*|*" iam service-accounts list "*|*" iam roles list "*|\
    *" storage buckets list "*|*" compute disks list "*|*" compute firewall-rules list "*|\
    *" compute forwarding-rules list "*|*" compute routers nats list "*|\
    *" projects get-iam-policy "*|*" secrets list "*|*" secrets get-iam-policy "*)
    exit 0
    ;;
  *" sql instances list "*)
    if [ "${ORPHAN_SQL_PRESENT:-0}" = 1 ]; then
      printf '%s\n' "${ORPHAN_SQL_NAME:-sol-qual-postgres}"
    fi
    exit 0
    ;;
  *" services vpc-peerings list "*)
    if [ "${ORPHAN_PEERING_PRESENT:-0}" = 1 ]; then
      printf 'ACTIVE\n'
    fi
    exit 0
    ;;
esac
case "$1 $2" in
  "auth application-default")
    if [ "${FAIL_CREDENTIALS:-}" = 1 ]; then
      printf 'ERROR: (gcloud.auth.application-default.print-access-token) There was a problem refreshing your current auth tokens\n' >&2
      exit 254
    fi
    printf 'ya29.harness-token\n'
    exit 0
    ;;
  "container clusters")
    case " $* " in
      *autopilot.enabled*)
        if [ "${STUB_AUTOPILOT:-0}" = "1" ]; then
          printf '{"autopilot":{"enabled":true}}\n'
        else
          # What GKE returns for a standard cluster: an empty `autopilot` object,
          # not `enabled: false` (sol-fab/sol#1285).
          printf '{"autopilot":{}}\n'
        fi
        exit 0
        ;;
    esac
    case " $* " in
      *" get-credentials "*)
        case " $* " in
          *" --kubeconfig "*) exit 93 ;;
        esac
        path="${KUBECONFIG:-}"
        [ -n "$path" ] || exit 92
        printf '%s\n' "$path" >>"$KUBECONFIG_LOG"
        if [ "${FAIL_ON:-}" = access ] && [ ! -e "$FAIL_MARKER_DIR/access" ]; then
          : >"$FAIL_MARKER_DIR/access"; exit 20
        fi
        : >"$path"
        printf 'gcp-provisioner\n' >"$FAIL_MARKER_DIR/kubeconfig-role"
        exit 0
        ;;
      *" describe "*)
        if [ "${DESTROYING:-}" = 1 ]; then
          echo "ERROR: (gcloud.container.clusters.describe) ResponseError: code=404, message=Not found: projects/sol-qualification/locations/us-central1/clusters/sol-qual." >&2
          exit 1
        fi
        printf 'RUNNING\n'; exit 0
        ;;
    esac
    ;;
  "sql instances")
    if [ "${DESTROYING:-}" = 1 ]; then
      echo "ERROR: (gcloud.sql.instances.describe) HTTPError 404: The Cloud SQL instance does not exist." >&2
      exit 1
    fi
    printf 'RUNNABLE\n'; exit 0
    ;;
  "services vpc-peerings")
    if [ "${DESTROYING:-}" = 1 ]; then
      echo "ERROR: (gcloud.services.vpc-peerings.list) NOT_FOUND: The network was not found" >&2
      exit 1
    fi
    printf 'servicenetworking-googleapis-com\n'
    exit 0
    ;;
  "compute networks")
    case " $* " in
      *" describe sol-orphan "*)
        if [ "${DECLARED_ORPHAN_PRESENT:-}" = 1 ]; then
          printf 'name: sol-orphan\nselfLink: https://www.googleapis.com/compute/v1/projects/sol-qualification/global/networks/sol-orphan\n'
          exit 0
        fi
        if [ "${DECLARED_ORPHAN_UNKNOWN:-}" = 1 ]; then
          echo "ERROR: (gcloud.compute.networks.describe) Throttling: rate exceeded" >&2
          exit 1
        fi
        echo "ERROR: (gcloud.compute.networks.describe) Could not fetch resource: - The resource 'projects/sol-qualification/global/networks/sol-orphan' was not found" >&2
        exit 1
        ;;
    esac
    if [ "${DESTROYING:-}" = 1 ]; then
      echo "ERROR: (gcloud.compute.networks.describe) Could not fetch resource: - The resource 'projects/sol-qualification/global/networks/sol-qual' was not found" >&2
      exit 1
    fi
    exit 0
    ;;
  "artifacts repositories"|"compute addresses")
    if [ "${DESTROYING:-}" = 1 ]; then
      echo "ERROR: (gcloud.$1.$2.describe) NOT_FOUND: Resource was not found" >&2
      exit 1
    fi
    exit 0
    ;;
esac
exit 90
