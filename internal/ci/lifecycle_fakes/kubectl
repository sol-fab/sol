#!/usr/bin/env bash
set -eu
printf 'kubectl %s\n' "$*" >>"$LIFECYCLE_LOG"

# The live workload identities and the UIDs the workspace recorded at apply come from one
# file (owned_workloads.tsv, copied alongside this fake), so the listing and the per-object
# UID read cannot drift from the record the harness seeds.
owned_seed="$(dirname "$0")/owned_workloads.tsv"

namespace_arg() {
  previous=""
  for argument in "$@"; do
    if [ "$previous" = "-n" ]; then
      printf '%s' "$argument"
      return
    fi
    previous="$argument"
  done
}

resource_arg() { # the resource named after "get"
  previous=""
  for argument in "$@"; do
    if [ "$previous" = "get" ]; then
      printf '%s' "$argument"
      return
    fi
    previous="$argument"
  done
}

name_arg() { # the object named after that resource
  resource="$(resource_arg "$@")"
  previous=""
  for argument in "$@"; do
    if [ "$previous" = "$resource" ]; then
      printf '%s' "$argument"
      return
    fi
    previous="$argument"
  done
}

configmap_path() { printf '%s/configmap-%s' "$FAIL_MARKER_DIR" "$1"; }
file_arg() {
  previous=""
  for argument in "$@"; do
    if [ "$previous" = "-f" ]; then printf '%s' "$argument"; return; fi
    previous="$argument"
  done
}

case " $* " in
  *" get configmap sol-boundary-lease-"*)
    lease_file="$(configmap_path "$(name_arg "$@")")"
    if [ -f "$lease_file" ]; then cat "$lease_file"; exit 0; fi
    printf 'Error from server (NotFound): configmaps "%s" not found\n' "$(name_arg "$@")" >&2
    exit 1
    ;;
  *" create -f "*)
    input_file="$(file_arg "$@")"
    configmap_name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["metadata"]["name"])' "$input_file" 2>/dev/null || true)"
    case "$configmap_name" in
      sol-boundary-lease-*)
        python3 -c 'import json,sys; p=sys.argv[2]; x=json.load(open(sys.argv[1])); x.setdefault("metadata", {})["resourceVersion"]="1"; json.dump(x,open(p,"w"))' "$input_file" "$(configmap_path "$configmap_name")"
        printf 'configmap/%s created\n' "$configmap_name"
        exit 0
        ;;
    esac
    ;;
  *" replace -f "*)
    input_file="$(file_arg "$@")"
    configmap_name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["metadata"]["name"])' "$input_file" 2>/dev/null || true)"
    case "$configmap_name" in
      sol-boundary-lease-*)
        python3 -c 'import json,sys; p=sys.argv[2]; x=json.load(open(sys.argv[1])); x.setdefault("metadata", {})["resourceVersion"]="2"; json.dump(x,open(p,"w"))' "$input_file" "$(configmap_path "$configmap_name")"
        printf 'configmap/%s replaced\n' "$configmap_name"
        exit 0
        ;;
    esac
    ;;
  *" delete configmap sol-boundary-lease-"*)
    deleted_name=""
    saw_configmap=0
    for argument in "$@"; do
      if [ "$saw_configmap" = 1 ]; then deleted_name="$argument"; break; fi
      [ "$argument" = configmap ] && saw_configmap=1
    done
    rm -f "$(configmap_path "$deleted_name")"
    printf 'configmap/%s deleted\n' "$deleted_name"
    exit 0
    ;;
esac

owned_uid() { # resource namespace name
  awk -F'\t' -v r="$1" -v ns="$2" -v n="$3" '
    $0 !~ /^#/ && $1 == r && $2 == ns && $3 == n { print $4; exit }
  ' "$owned_seed"
}

owned_listing() { # resource namespace
  awk -F'\t' -v r="$1" -v ns="$2" '
    BEGIN { printf "{\"items\":["; found = 0 }
    $0 !~ /^#/ && NF == 4 && $1 == r && $2 == ns {
      kind = ($1 == "deployment" ? "Deployment" : $1 == "cronjob" ? "CronJob" : $1 == "job" ? "Job" : "Rollout")
      if (found) printf ","
      printf "{\"kind\":\"%s\",\"metadata\":{\"name\":\"%s\",\"uid\":\"%s\"},\"spec\":{\"template\":{\"metadata\":{\"labels\":{\"workspace\":\"work\"}}}}}", kind, $3, $4
      found = 1
    }
    END { printf "]}\n" }
  ' "$owned_seed"
}

case " $* " in
  *" auth whoami "*)
    case "$(cat "$FAIL_MARKER_DIR/kubeconfig-role" 2>/dev/null || true)" in
      sol-cluster-access)
        if [ "${WHOAMI_REFUSE:-}" = 1 ] &&
          [ "$(cat "$FAIL_MARKER_DIR/bootstrap-window" 2>/dev/null || true)" = "false" ]; then
          printf 'error: You must be logged in to the server (Unauthorized)\n' >&2
          exit 1
        fi
        if [ ! -e "${LIFECYCLE_LOG}.whoami-401-seen" ]; then
          : >"${LIFECYCLE_LOG}.whoami-401-seen"
          printf 'error: You must be logged in to the server (Unauthorized)\n' >&2
          exit 1
        fi
        printf '%s\n' '{"apiVersion":"authentication.k8s.io/v1","kind":"SelfSubjectReview","status":{"userInfo":{"username":"arn:aws:sts::111122223333:assumed-role/sol-cluster-access/EKSGetTokenAuth","extra":{"arn":["arn:aws:sts::111122223333:assumed-role/sol-cluster-access/EKSGetTokenAuth"],"canonicalArn":["arn:aws:iam::111122223333:role/sol-cluster-access"]}}}}'
        ;;
      sol-provisioner) printf '%s\n' '{"apiVersion":"authentication.k8s.io/v1","kind":"SelfSubjectReview","metadata":{"creationTimestamp":null},"status":{"userInfo":{"username":"arn:aws:sts::111122223333:assumed-role/sol-provisioner/EKSGetTokenAuth","uid":"aws-iam-authenticator:111122223333:AROA","groups":["system:authenticated","sol:platform-provisioners"],"extra":{"arn":["arn:aws:sts::111122223333:assumed-role/sol-provisioner/EKSGetTokenAuth"],"canonicalArn":["arn:aws:iam::111122223333:role/sol-provisioner"],"sessionName":["EKSGetTokenAuth"]}}}}' ;;
      *) printf '{"status":{"userInfo":{}}}\n' ;;
    esac
    exit 0
    ;;
  *" auth can-i escalate clusterroles "*|*" auth can-i bind clusterroles "*|\
    *" auth can-i create namespaces "*|*" auth can-i create clusterroles "*|\
    *" auth can-i create storageclasses "*)
    if [ "$(cat "$FAIL_MARKER_DIR/kubeconfig-role" 2>/dev/null || true)" != "sol-cluster-access" ]; then
      printf 'error: the authorizer was asked about the wrong principal\n' >&2
      exit 90
    fi
    case " $* " in
      *" can-i escalate clusterroles "*|*" can-i bind clusterroles "*)
        if [ "${CAN_I_FAIL:-}" = 1 ] &&
          [ "$(cat "$FAIL_MARKER_DIR/bootstrap-window" 2>/dev/null || true)" = "false" ]; then
          printf 'error: unable to connect to the server: dial tcp: i/o timeout\n' >&2
          exit 1
        fi
        if [ "${CAN_I_INDETERMINATE_WHEN_OPEN:-}" = 1 ] &&
          [ "$(cat "$FAIL_MARKER_DIR/bootstrap-window" 2>/dev/null || true)" = "true" ] &&
          case " $* " in *" can-i escalate clusterroles "*) true ;; *) false ;; esac; then
          printf 'maybe\n'
          exit 0
        fi
        if [ "${WINDOW_OPEN:-}" = 1 ] ||
          [ "$(cat "$FAIL_MARKER_DIR/bootstrap-window" 2>/dev/null || true)" = "true" ]; then
          printf 'yes\n'
          exit 0
        fi
        printf 'no - no RBAC policy matched\n'
        exit 1
        ;;
      *" can-i create namespaces "*)
        if [ "${FAIL_ON:-}" = rbac ] && [ ! -e "$FAIL_MARKER_DIR/rbac" ]; then
          : >"$FAIL_MARKER_DIR/rbac"
          exit 20
        fi
        if [ "${SUCCESSOR_DENIED:-}" = 1 ] &&
          [ "$(cat "$FAIL_MARKER_DIR/bootstrap-window" 2>/dev/null || true)" = "false" ]; then
          printf 'no - no RBAC policy matched\n'
          exit 1
        fi
        printf 'yes\n'
        exit 0
        ;;
      *" can-i create clusterroles "*|*" can-i create storageclasses "*)
        if [ "${SUCCESSOR_DENIED:-}" = 1 ] &&
          [ "$(cat "$FAIL_MARKER_DIR/bootstrap-window" 2>/dev/null || true)" = "false" ]; then
          printf 'no - no RBAC policy matched\n'
          exit 1
        fi
        printf 'yes\n'
        exit 0
        ;;
    esac
esac
case " $* " in
  *" get secret sol-secrets "*)
    printf '{"data":{"POSTGRES_URL":"cG9zdGdyZXNxbDovL2xpZmVjeWNsZTpvZmZsaW5lQGxvY2FsaG9zdDo1NDMyL3Rlc3Q=","SOL_API_KEY":"b2ZmbGluZS1zZWNyZXQ="}}\n'
    exit 0
    ;;
  *" get secret "*"-secrets "*)
    printf '{"data":{"POSTGRES_URL":"cG9zdGdyZXNxbDovL2xpZmVjeWNsZTpvZmZsaW5lQGxvY2FsaG9zdDo1NDMyL3Rlc3Q=","SOL_API_KEY":"b2ZmbGluZS1zZWNyZXQ=","KAFKA_SASL_PASSWORD":"b2ZmbGluZS1rYWZrYQ==","KAFKA_SSL_CA_CERT":"b2ZmbGluZS1jZXJ0"}}\n'
    exit 0
    ;;
  *" get secret redpanda-users -n redpanda "*)
    if [ "${PLATFORM_CREDENTIAL_ABSENT:-}" = 1 ]; then
      printf 'Error from server (NotFound): secrets "redpanda-users" not found\n' >&2
      exit 1
    fi
    if [ "${PLATFORM_CREDENTIAL_UNVERIFIABLE:-}" = 1 ]; then
      printf 'error: You must be logged in to the server (Unauthorized)\n' >&2
      exit 1
    fi
    printf 'secret/redpanda-users\n'
    exit 0
    ;;
  *" get configmap sol-platform-network "*)
    # The cluster fact the platform publishes: which ranges reach this target's managed
    # database, and on which port. The substrate reads it before it applies the workload
    # egress allowance, and distinguishes it from a target that provisions no database —
    # so the fake must answer it (blank output is not JSON) and must be able to report the
    # absent and refused cases for the destinations that assert them.
    if [ "${PLATFORM_NETWORK_FACT_ABSENT:-}" = 1 ]; then
      printf 'Error from server (NotFound): configmaps "sol-platform-network" not found\n' >&2
      exit 1
    fi
    if [ "${PLATFORM_NETWORK_FACT_FORBIDDEN:-}" = 1 ]; then
      printf 'Error from server (Forbidden): configmaps "sol-platform-network" is forbidden\n' >&2
      exit 1
    fi
    printf '{"data":{"database-egress-cidrs":"10.0.0.0/16","database-port":"5432"}}\n'
    exit 0
    ;;
  *" get configmap sol-release-"*)
    # The release-boundary ConfigMaps a seeded harness writes through
    # print_release_record.exe. Without one, the workspace has no recorded UID evidence, so
    # the removal paths must retain (the no-evidence case).
    cm_name="$(name_arg "$@")"
    if [ -n "${FAKE_CONFIGMAP_DIR:-}" ] && [ -f "$FAKE_CONFIGMAP_DIR/$cm_name" ]; then
      cat "$FAKE_CONFIGMAP_DIR/$cm_name"
      exit 0
    fi
    printf 'Error from server (NotFound): configmaps "%s" not found\n' "$cm_name" >&2
    exit 1
    ;;
  *" get deployment "*)
    if [ "${CLUSTER_UNREACHABLE:-}" = 1 ]; then
      printf 'error: Unable to connect to the server: dial tcp 10.0.0.1:443: i/o timeout\n' >&2
      exit 1
    fi
    namespace="$(namespace_arg "$@")"
    if case " $* " in *" -o jsonpath="*) true ;; *) false ;; esac; then
      uid="$(owned_uid deployment "$namespace" "$(name_arg "$@")")"
      if [ -n "$uid" ]; then
        printf '%s' "$uid"
        exit 0
      fi
      printf 'Error from server (NotFound): deployments "%s" not found\n' "$(name_arg "$@")" >&2
      exit 1
    fi
    if [ "${WORKSPACE_PODS:-}" = 1 ]; then
      owned_listing deployment "$namespace"
    else
      printf '{"items":[]}\n'
    fi
    exit 0
    ;;
  *" get cronjob "*|*" get job "*)
    if [ "${CLUSTER_UNREACHABLE:-}" = 1 ]; then
      printf 'error: Unable to connect to the server: dial tcp 10.0.0.1:443: i/o timeout\n' >&2
      exit 1
    fi
    namespace="$(namespace_arg "$@")"
    resource="$(resource_arg "$@")"
    if case " $* " in *" -o jsonpath="*) true ;; *) false ;; esac; then
      uid="$(owned_uid "$resource" "$namespace" "$(name_arg "$@")")"
      if [ -n "$uid" ]; then
        printf '%s' "$uid"
        exit 0
      fi
      printf 'Error from server (NotFound): %ss "%s" not found\n' "$resource" "$(name_arg "$@")" >&2
      exit 1
    fi
    printf '{"items":[]}\n'
    exit 0
    ;;
  *" get rollout "*)
    if [ "${CLUSTER_UNREACHABLE:-}" = 1 ]; then
      printf 'error: Unable to connect to the server: dial tcp 10.0.0.1:443: i/o timeout\n' >&2
      exit 1
    fi
    if [ "${ROLLOUT_SERVED:-}" != 1 ]; then
      printf "error: the server doesn't have a resource type \"rollout\"\n" >&2
      exit 1
    fi
    namespace="$(namespace_arg "$@")"
    if case " $* " in *" -o jsonpath="*) true ;; *) false ;; esac; then
      uid="$(owned_uid rollout "$namespace" "$(name_arg "$@")")"
      if [ -n "$uid" ]; then
        printf '%s' "$uid"
        exit 0
      fi
      printf 'Error from server (NotFound): rollouts "%s" not found\n' "$(name_arg "$@")" >&2
      exit 1
    fi
    if [ "${WORKSPACE_PODS:-}" = 1 ]; then
      owned_listing rollout "$namespace"
    else
      printf '{"items":[]}\n'
    fi
    exit 0
    ;;
  *" delete deployment/"*|*" delete rollout/"*|*" delete cronjob/"*|*" delete job/"*)
    if [ "${RELEASE_DELETE_FAILS:-}" = 1 ]; then
      printf 'error: the workload could not be deleted\n' >&2
      exit 1
    fi
    printf 'workload deleted\n'
    exit 0
    ;;
  *" wait --for=delete pod -n "*)
    if [ "${RELEASE_WAIT_FAILS:-}" = 1 ]; then
      printf 'error: timed out waiting for the pods to go\n' >&2
      exit 1
    fi
    : >"$FAIL_MARKER_DIR/pods-released"
    printf 'pod deleted\n'
    exit 0
    ;;
  *" api-resources "*)
    printf 'NAME        SHORTNAMES   APIVERSION   NAMESPACED   KIND\n'
    printf 'namespaces  ns           v1           false        Namespace\n'
    printf 'clusterroles             rbac.authorization.k8s.io/v1  false  ClusterRole\n'
    if [ "${CRD_SERVED:-}" = 1 ]; then
      printf 'clusterissuers           cert-manager.io/v1  false  ClusterIssuer\n'
    fi
    exit 0
    ;;
esac

set -eu
printf 'kubectl %s\n' "$*" >>"$LIFECYCLE_LOG"
[ "$KUBECONFIG" != /ambient/forbidden ] || exit 93
if [ "${DESTROYING:-}" = 1 ]; then
  case "$*" in "get namespace "*) exit 1 ;; esac
fi
if [ "${AUTH_ABSENT:-}" = 1 ]; then
  case "$*" in "auth can-i "*) exit 94 ;; esac
fi
if [ "${RBAC_ABSENT:-}" = 1 ]; then
  case "$*" in
    "auth can-i --list") : ;;
    "auth can-i "*) exit 1 ;;
  esac
fi
if [ "${CRDS_ABSENT:-}" = 1 ]; then
  case "$*" in *"--for=condition=Established"*) exit 1 ;; esac
fi
if [ "${FRESH_TARGET:-}" = 1 ] && [ ! -e "${PLATFORM_INSTALLED_FILE:-/nonexistent}" ]; then
  case "$*" in *"--for=condition=Established"*) exit 1 ;; esac
fi
if [ "${FAIL_ON:-}" = crds ] && [ ! -e "$FAIL_MARKER_DIR/crds" ] &&
   case "$*" in *"--timeout=180s"*) true;; *) false;; esac; then
  : >"$FAIL_MARKER_DIR/crds"; exit 20
fi
if [ "${FAIL_ON:-}" = rbac ] && [ ! -e "$FAIL_MARKER_DIR/rbac" ] &&
   case "$*" in "auth can-i create namespaces") true;; *) false;; esac; then
  : >"$FAIL_MARKER_DIR/rbac"; exit 20
fi
if [ "${FAIL_READINESS_ALWAYS:-}" = 1 ] &&
   case "$*" in *"csidriver/ebs.csi.aws.com"*) true;; *) false;; esac; then
  exit 20
fi
case "$*" in
  "auth can-i "*" -n default") exit 1 ;;
  "auth can-i bind "*|"auth can-i escalate "*) exit 1 ;;
  "get storageclass -o jsonpath="*)
    if [ "${STORAGE_CLASS_WRONG:-}" = 1 ]; then
      printf 'gp3|pd.csi.storage.gke.io|true '
    else
      printf 'gp3|ebs.csi.aws.com|true '
    fi
    ;;
  *"service/ingress-nginx-controller"*) printf 'lb.example.test' ;;
  *"get daemonset -n monitoring -o jsonpath="*) printf '4/4 4/4 ' ;;
  *"get statefulset -n monitoring -o jsonpath="*) printf '1/1 1/1 1/1 ' ;;
  *"get statefulset -n redpanda -o jsonpath="*) printf '3/3 ' ;;
  *"get pvc -n monitoring -o jsonpath="*) printf 'Bound Bound ' ;;
  *"get pvc -n redpanda -o jsonpath="*) printf 'Bound Bound ' ;;
  *"get nodes -o jsonpath="*) printf 'True True True True ' ;;
esac
if [ "${FAIL_ON:-}" = readiness ] && [ ! -e "$FAIL_MARKER_DIR/readiness" ] &&
   case "$*" in *"csidriver/ebs.csi.aws.com"*) true;; *) false;; esac; then
  : >"$FAIL_MARKER_DIR/readiness"; exit 20
fi
